{
  "id": "/",
  "name": "Ultimate Transport",
  "short_name": "Ultimate Transport",
  "description": "Affordable wheelchair transportation in St. Paul and the Twin Cities.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/?src=homescreen",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#FFFFFF",
  "theme_color": "#0E3355",
  "categories": [
    "medical",
    "travel",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/assets/favicon-32.png?v=2",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/assets/apple-touch-icon.png?v=2",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/icon.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Call to schedule",
      "short_name": "Call",
      "description": "Call the scheduling line",
      "url": "/?action=call"
    }
  ]
}
