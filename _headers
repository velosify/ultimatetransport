# Cloudflare Pages custom headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The page is one file and changes rarely — let the browser revalidate it
# so a copy edit goes live immediately instead of sitting in a stale cache.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Static assets: cache hard. The icons and the link-preview card are referenced
# with a ?v= query in index.html, 404.html and site.webmanifest, so bump that
# number whenever you replace one or browsers will hold the old file for a week.
/assets/*
  Cache-Control: public, max-age=604800

# The service worker must always be revalidated, or a stale copy pins the site.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
