# Cloudflare Pages custom headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# The page is one file and changes rarely — let the browser revalidate it
# so a copy edit goes live immediately instead of sitting in a stale cache.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprint-free static assets: cache hard, bust by renaming the file.
/assets/*
  Cache-Control: public, max-age=604800
